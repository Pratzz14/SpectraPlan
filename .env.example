# Copy to .env at the repository root. Never place keys in VITE_* variables.
GROQ_API_KEY=your_groq_api_key_here
REGOLO_API_KEY=your_regolo_api_key_here
LLMTECH_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_THINKING_LEVEL=medium
PROVIDER_NAME=auto
# Default automatic order; add regolo explicitly if you want that optional provider.
PROVIDER_ORDER=gemini,llmtech,groq
REGOLO_BASE_URL=https://api.regolo.ai/v1
REGOLO_MODEL=Llama-3.3-70B-Instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
LLMTECH_BASE_URL=https://api.llmtech.eu/v1
LLMTECH_MODEL=nvidia/Qwen3.8-27B-NVFP4
PROVIDER_PROBE_TIMEOUT_S=8
PROVIDER_HEALTH_TTL_S=300
PROVIDER_FAILURE_TTL_S=30
PROVIDER_REASONING_EFFORT=medium
PROVIDER_CALL_TIMEOUT_S=30
REQUEST_DEADLINE_S=90
ASSESSMENT_MAX_DESCRIPTION_CHARS=8000
PROVIDER_MAX_RETRIES=2
PROVIDER_MAX_COMPLETION_TOKENS=4096
EXTRACTION_MAX_COMPLETION_TOKENS=3072
SYNTHESIS_MAX_COMPLETION_TOKENS=4096
RETRIEVAL_SEMANTIC_MIN_SCORE=0.65

# Relative paths resolve from the repository root, even from another CWD.
SOURCE_DIR=knowledge/original_sources
CORPUS_DIR=knowledge
SMOKE_OUTPUT_DIR=outputs/provider_smoke
EXPLAINABILITY_DB_PATH=outputs/assessment/explainability.sqlite
INGEST_CACHE_DIR=outputs/ingest/cache
EMBEDDING_CACHE_DIR=outputs/embedding_models
WEB_CORPUS_DIR=knowledge/web
INGEST_CONCURRENCY=1
INGEST_MAX_OUTPUT_TOKENS=1000

# Archived final evaluation used explicit CLI overrides: 180s request / 60s call.
# These are historical evaluation settings, not the normal 90s / 30s defaults above.

# PDF knowledge extraction (separate from assessment providers)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ws-xprw8y59epuehnse.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_EXTRACTION_MODEL=qwen3.7-flash

# Add-file ingestion and browser upload limit (50 MB).
KNOWLEDGE_WORK_DIR=outputs/pdf_knowledge
KNOWLEDGE_UPLOAD_MAX_BYTES=52428800

# Knowledge extraction retries and local OCR recovery
KNOWLEDGE_EXTRACTION_ATTEMPTS=3
KNOWLEDGE_RETRY_DELAY_S=1
KNOWLEDGE_OCR_TIMEOUT_S=60
KNOWLEDGE_OCR_LANGUAGE=eng
# KNOWLEDGE_OCR_TESSDATA=C:/Program Files/Tesseract-OCR/tessdata
