# Local credentials and environment configuration
.env
.local/
.env.*
!.env.example
!.env.*.example

# Python environments, caches and packaging
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Frontend dependencies, build output and tooling caches
node_modules/
# Deferred presentation work stays local, including sources and generated decks.
/presentation/
dist/
build/
.vite/
.vite-temp/
.eslintcache
coverage/
*.tsbuildinfo

# Local logs, temporary files and browser test artifacts
*.log
tmp/
temp/
playwright-report/
test-results/

# Organizer-supplied originals are provided separately
/knowledge/original_sources/
/customer_scenarios_for_final_evaluation.txt

# OS and local editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo

# Keep reviewed corpus files and required evaluation outputs trackable.
# Do not ignore knowledge/*.json, knowledge/*.jsonl or outputs/ globally.

# Routine diagnostic runs stay local; explicitly retain source-reviewed run records.
/outputs/assessment/[0-9]*.json
/outputs/assessment/explainability.sqlite*
/outputs/development/[0-9]*
/outputs/runs/**/*.sqlite*
/outputs/diagnostics/**/*.sqlite*
# Redundant trace PDF renderings stay local; portable JSON traces are retained.
/outputs/runs/**/*.trace.pdf
/outputs/setup_checks/trace.pdf
/outputs/test-tmp-*/
