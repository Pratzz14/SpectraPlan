# Local credentials and environment configuration
.env
.env.*
!.env.example
!.env.*.example

# Python environments, caches and packaging
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Frontend dependencies, build output and tooling caches
node_modules/
dist/
build/
.vite/
.vite-temp/
.eslintcache
coverage/
*.tsbuildinfo

# Local logs, temporary files and browser test artifacts
*.log
tmp/
temp/
playwright-report/
test-results/

# Organizer-supplied originals are provided separately
/knowledge/original_sources/

# OS and local editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo

# Keep reviewed corpus files and required evaluation outputs trackable.
# Do not ignore knowledge/*.json, knowledge/*.jsonl or outputs/ globally.

# Routine diagnostic runs stay local; explicitly retain source-reviewed run records.
/outputs/assessment/[0-9]*.json
!/outputs/assessment/20261017T204318Z_3ebb9b193319407aa703eca6dd222209.json
/outputs/extraction/[0-9]*.json
!/outputs/extraction/20261017T162638Z_eca1681faa1948bd9a0b11aacd0c05e3.json
!/outputs/extraction/20261017T162839Z_2d073001ae594680b250652ae122a62c.json
/outputs/retrieval/[0-9]*.json
!/outputs/retrieval/20261017T172345052038Z.json

# Rebuildable ingestion working data and local model binaries
/outputs/embedding_models/
/outputs/ingest/cache/
/knowledge/.staging/
/knowledge/versions/*/qdrant/
/knowledge/versions/*/assets/
/knowledge/versions/*/raw_pages.json
/knowledge/versions/*/review.html

# Keep the local source checkpoint while committing only its summary and instructions.
/knowledge/saved_extraction_64/*
!/knowledge/saved_extraction_64/README.md
!/knowledge/saved_extraction_64/checkpoint.json
/outputs/ingest/pytest*/
/outputs/ingest/live_partial_records.json
/outputs/ingest/retry_llmtech_pages.py
/outputs/ingest/save_checkpoint.py

# Website snapshots keep extracted provenance trackable; raw HTML and vector binaries stay local.
/knowledge/web/.staging/
/knowledge/web/versions/*/html/
/knowledge/web/versions/*/qdrant/
