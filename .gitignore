# Local credentials and environment configuration
.env
.local/
.env.*
!.env.example
!.env.*.example

# Python environments, caches and packaging
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# Frontend dependencies, build output and tooling caches
node_modules/
# Deferred presentation work stays local, including sources and generated decks.
/presentation/
dist/
build/
.vite/
.vite-temp/
.eslintcache
coverage/
*.tsbuildinfo

# Local logs, temporary files and browser test artifacts
*.log
tmp/
temp/
playwright-report/
test-results/

# Organizer-supplied originals are provided separately
/knowledge/original_sources/
/customer_scenarios_for_final_evaluation.txt

# OS and local editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo

# Generated diagnostics, evaluation runs, and local runtime data
/outputs/*
!/outputs/README.md

# Rebuildable ingestion working data and local model binaries
/knowledge/.staging/
/knowledge/versions/*/qdrant/
/knowledge/versions/*/inspection/qdrant/
/knowledge/versions/*/assets/
/knowledge/versions/*/raw_pages.json
/knowledge/versions/*/review.html

# Keep the local source checkpoint while committing only its summary and instructions.
/knowledge/saved_extraction_64/*
!/knowledge/saved_extraction_64/README.md
!/knowledge/saved_extraction_64/checkpoint.json

# Website snapshots keep extracted provenance trackable; raw HTML and vector binaries stay local.
/knowledge/web/.staging/
/knowledge/web/versions/*/html/
/knowledge/web/versions/*/qdrant/

# Local registrations of user-added originals.
/knowledge/added_sources.json
