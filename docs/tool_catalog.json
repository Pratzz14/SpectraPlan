{
  "catalog_version": "2",
  "status": "Implemented bindings; agent tool registration/adapters are planned, not registered",
  "contract_document": "tool_contracts.md",
  "tools": [
    {
      "name": "knowledge_search_status",
      "binding": {
        "kind": "http",
        "method": "GET",
        "path": "/api/search/status"
      },
      "effect": "read_only",
      "generative_model_calls": 0,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "knowledge_search",
      "binding": {
        "kind": "http",
        "method": "POST",
        "path": "/api/search"
      },
      "effect": "read_only",
      "generative_model_calls": 0,
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "mode": {
            "default": "compare",
            "enum": [
              "compare",
              "bm25",
              "qdrant",
              "hybrid"
            ],
            "title": "Mode",
            "type": "string"
          },
          "dataset": {
            "default": "technical",
            "enum": [
              "technical",
              "website",
              "all"
            ],
            "title": "Dataset",
            "type": "string"
          },
          "limit": {
            "default": 6,
            "maximum": 8,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "expand_synonyms": {
            "default": true,
            "title": "Expand Synonyms",
            "type": "boolean"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      }
    },
    {
      "name": "website_refresh",
      "binding": {
        "kind": "cli",
        "module": "backend.web_ingest",
        "command": "crawl",
        "python": "backend.web_ingest.crawl"
      },
      "effect": "external_network_and_snapshot_publication",
      "generative_model_calls": 0,
      "input_schema": {
        "type": "object",
        "properties": {
          "max_pages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40,
            "default": 20
          },
          "max_depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "default": 2
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "website_validate",
      "binding": {
        "kind": "cli",
        "module": "backend.web_ingest",
        "command": "validate"
      },
      "effect": "read_only",
      "generative_model_calls": 0,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "technical_corpus_validate",
      "binding": {
        "kind": "cli",
        "module": "backend.ingest",
        "command": "validate"
      },
      "effect": "read_only",
      "generative_model_calls": 0,
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "case_evidence_retrieval",
      "binding": {
        "kind": "http",
        "method": "POST",
        "path": "/api/retrieve",
        "python": "backend.retrieval.CaseRetrievalService.retrieve_case"
      },
      "effect": "read_only",
      "generative_model_calls": 0,
      "input_schema": {
        "$defs": {
          "CustomerStatement": {
            "additionalProperties": false,
            "properties": {
              "text": {
                "minLength": 1,
                "title": "Text",
                "type": "string"
              },
              "kind": {
                "enum": [
                  "reported_fact",
                  "requested_outcome",
                  "proposed_approach",
                  "customer_claim"
                ],
                "title": "Kind",
                "type": "string"
              },
              "context_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "title": "Context Ids",
                "type": "array"
              },
              "input_quote": {
                "minLength": 1,
                "title": "Input Quote",
                "type": "string"
              }
            },
            "required": [
              "text",
              "kind",
              "input_quote"
            ],
            "title": "CustomerStatement",
            "type": "object"
          },
          "FactProvenance": {
            "additionalProperties": false,
            "properties": {
              "field_path": {
                "description": "JSON Pointer to one stated scalar or list item, e.g. /contexts/0/sample_phase",
                "minLength": 1,
                "title": "Field Path",
                "type": "string"
              },
              "context_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "title": "Context Ids",
                "type": "array"
              },
              "input_quote": {
                "minLength": 1,
                "title": "Input Quote",
                "type": "string"
              }
            },
            "required": [
              "field_path",
              "input_quote"
            ],
            "title": "FactProvenance",
            "type": "object"
          },
          "MeasurementContext": {
            "additionalProperties": false,
            "properties": {
              "context_id": {
                "pattern": "^stream_[1-9][0-9]*$",
                "title": "Context Id",
                "type": "string"
              },
              "label": {
                "description": "One short verbatim phrase copied from the enquiry",
                "minLength": 1,
                "title": "Label",
                "type": "string"
              },
              "target_analytes": {
                "description": "Requested analytes or composition variables; populate whenever the customer names a measurement target",
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "title": "Target Analytes",
                "type": "array"
              },
              "measurement_goals": {
                "description": "Requested outcomes or comparisons, not bare concentration ranges",
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "title": "Measurement Goals",
                "type": "array"
              },
              "sample_matrix": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Verbatim material/product description including stated components where possible",
                "title": "Sample Matrix"
              },
              "sample_phase": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Explicit sample form, including powder, slurry or liquid. Copy the stated word; powder is powder, not solid. Null only when form is unstated",
                "title": "Sample Phase"
              },
              "appearance": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Verbatim stated optical appearance such as opaque, clear or turbid; otherwise null",
                "title": "Appearance"
              },
              "temperature": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Verbatim stated range/units or qualitative temperature wording; otherwise null",
                "title": "Temperature"
              },
              "pressure": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Verbatim stated pressure, including any basis/units; otherwise null",
                "title": "Pressure"
              },
              "response_time_raw": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Verbatim REQUESTED measurement response time, even if units are ambiguous. Existing laboratory delays are not a requested response time",
                "title": "Response Time Raw"
              },
              "response_time_s": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Response Time S"
              },
              "concentration_range": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Verbatim concentration range and any stated basis/units. Preserve a given range even when its basis is unknown; clarify basis separately",
                "title": "Concentration Range"
              },
              "required_error": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Verbatim customer error requirement and units; otherwise null",
                "title": "Required Error"
              },
              "reference_assays": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "title": "Reference Assays",
                "type": "array"
              },
              "process_constraints": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "title": "Process Constraints",
                "type": "array"
              },
              "missing_information": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "title": "Missing Information",
                "type": "array"
              }
            },
            "required": [
              "context_id",
              "label"
            ],
            "title": "MeasurementContext",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "contexts": {
            "items": {
              "$ref": "#/$defs/MeasurementContext"
            },
            "title": "Contexts",
            "type": "array"
          },
          "customer_claims_and_requests": {
            "items": {
              "$ref": "#/$defs/CustomerStatement"
            },
            "title": "Customer Claims And Requests",
            "type": "array"
          },
          "shared_constraints": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Shared Constraints",
            "type": "array"
          },
          "missing_information": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Missing Information",
            "type": "array"
          },
          "fact_provenance": {
            "items": {
              "$ref": "#/$defs/FactProvenance"
            },
            "title": "Fact Provenance",
            "type": "array"
          }
        },
        "title": "CaseFacts",
        "type": "object"
      }
    },
    {
      "name": "evidence_resolve",
      "binding": {
        "kind": "http",
        "method": "GET",
        "path": "/api/evidence/{evidence_id}"
      },
      "effect": "read_only",
      "generative_model_calls": 0,
      "input_schema": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "corpus_version": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "revision": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "evidence_id"
        ],
        "additionalProperties": false
      }
    }
  ]
}
